{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "employee-management-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/employee-management-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "1.5mb", "maximumError": "2mb" }] },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": { "production": { "buildTarget": "employee-management-ui:build:production" }, "development": { "buildTarget": "employee-management-ui:build:development" } },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "c63d009f-13f2-45e1-8c77-28199db06ade"
  }
}
